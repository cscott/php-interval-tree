{
    "name": "dan-on/php-interval-tree",
    "description": "Is an implementation of interval binary search tree according to Thomas Cormen book \"Introduction to Algorithms\".",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniil Akhmetov",
            "email": "me@dan1.ru"
        }
    ],
    "autoload": {
        "psr-4": {
            "Danon\\IntervalTree\\": "src/",
            "Danon\\IntervalTree\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9",
        "phpstan/phpstan": "^1.3.3",
        "vimeo/psalm": "^6.18",
        "phpbench/phpbench": "^1.0",
        "phpmd/phpmd": "^2.10",
        "phpunit/php-code-coverage": "^9.2",
        "mediawiki/mediawiki-codesniffer": "52.0.1",
        "mediawiki/mediawiki-phan-config": "0.20.0"
    },
    "scripts": {
        "tests": "./vendor/bin/phpunit",
        "analyze": "./vendor/bin/phpcs -sp && @phan && ./vendor/bin/psalm && ./vendor/bin/phpstan && ./vendor/bin/phpmd src text phpmd.ruleset.xml",
        "bench": "./vendor/bin/phpbench run --report=aggregate",
        "phan": "phan --allow-polyfill-parser"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
